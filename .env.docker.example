APP_NAME="Competition Results"
APP_ENV=production
# ولّده بـ: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Damascus
# يجب أن يطابق الرابط الذي يفتحه الزوار (https عند تفعيل SSL)
APP_URL=https://SERVER_IP_OR_DOMAIN

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=competition_results
DB_USERNAME=results_user
DB_PASSWORD=change_this_database_password

# يُنشئ بها MySQL قاعدة البيانات أول مرة — MYSQL_PASSWORD يجب أن يطابق DB_PASSWORD
MYSQL_DATABASE=competition_results
MYSQL_USER=results_user
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_mysql_root_password

# الجلسات والكاش في Redis — مضبوطة في docker-compose.yml (environment)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# true فقط عند تشغيل الموقع عبر https
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=redis
REDIS_HOST=redis
CACHE_PREFIX=

MAIL_MAILER=log

# خلف Nginx المضيف و Nginx الحاوية
TRUSTED_PROXIES=*

# ---- الحماية ----
# قفل الحساب بعد محاولات دخول فاشلة (لكل بريد ولكل IP)
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCKOUT_MINUTES=15
# ترويسات الحماية (CSP وغيرها) — لا تعطلها في الإنتاج
SECURITY_HEADERS_ENABLED=true
# مدة الاحتفاظ بالسجل الأمني storage/logs/security-*.log (أيام)
SECURITY_LOG_DAYS=180
# الحد الأقصى لأسطر ملف الإكسل
RESULTS_MAX_ROWS=100000

# حجم ملف الإكسل الأقصى (كيلوبايت)
RESULTS_MAX_UPLOAD_KB=10240
# مدة تخزين ردود الـ API العام (ثوانٍ)
RESULTS_HTTP_CACHE=300

RUN_MIGRATIONS=false
RUN_SEEDERS=false
CLEAR_CACHE_ON_BOOT=true
OPTIMIZE_ON_BOOT=true
BUILD_STATIC_ON_BOOT=true
