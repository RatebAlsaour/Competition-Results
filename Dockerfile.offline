# بناء بدون إنترنت: يبدأ من صور المشروع الموجودة على السيرفر ويضيف الكود الجديد فقط.
# - PHP وامتداداته و vendor: من الصورة الحالية (لا تنزيل)
# - ملفات الواجهة public/build: تُبنى على جهاز المطور (npm run build) وتُرسل مع الكود
# يُستخدم تلقائياً من scripts/deploy-docker-server.sh عندما لا يصل السيرفر إلى الإنترنت.
# شرط: لم تتغير composer.json / composer.lock (وإلا يلزم بناء كامل بإنترنت).

FROM competition-results-app:latest AS app

ARG APP_BUILD_BRANCH=
ARG APP_BUILD_COMMIT=
ARG APP_BUILD_COMMIT_DATE=

ENV APP_BUILD_BRANCH="${APP_BUILD_BRANCH}" \
    APP_BUILD_COMMIT="${APP_BUILD_COMMIT}" \
    APP_BUILD_COMMIT_DATE="${APP_BUILD_COMMIT_DATE}"

USER root

# حذف كود النسخة السابقة (عدا vendor) حتى لا تبقى ملفات محذوفة من المشروع
RUN find . -mindepth 1 -maxdepth 1 ! -name vendor -exec rm -rf {} +

COPY --chown=www-data:www-data . .
COPY docker/php/php.ini /usr/local/etc/php/conf.d/99-competition-results.ini
COPY docker/php/www.conf /usr/local/etc/php-fpm.d/zz-competition-results.conf
COPY docker/php/entrypoint.sh /usr/local/bin/competition-results-entrypoint

RUN test -f public/build/manifest.json \
    && chmod +x /usr/local/bin/competition-results-entrypoint \
    && rm -f bootstrap/cache/packages.php bootstrap/cache/services.php bootstrap/cache/config.php bootstrap/cache/routes-*.php \
    && mkdir -p \
        storage/app/private \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        public/data \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache public \
    && composer dump-autoload --no-dev --optimize --classmap-authoritative --no-interaction

ENTRYPOINT ["competition-results-entrypoint"]
CMD ["php-fpm"]

FROM competition-results-nginx:latest AS nginx

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/app-fastcgi.conf /etc/nginx/snippets/app-fastcgi.conf
RUN rm -rf /var/www/html/public
COPY --from=app /var/www/html/public /var/www/html/public
RUN mkdir -p /var/www/html/public/data
