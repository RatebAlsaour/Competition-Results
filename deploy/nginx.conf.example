# Nginx على السيرفر (المضيف) أمام Docker — ينهي HTTPS ويمرر الطلبات إلى حاوية nginx على 127.0.0.1:8060
# المسار المقترح: /etc/nginx/sites-available/competition-results
#   sudo ln -s /etc/nginx/sites-available/competition-results /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# يمكن أن يعمل بجانب مشروع Evaluation على نفس السيرفر (ذاك على 8050 وهذا على 8060).

upstream competition_results {
    server 127.0.0.1:8060;
    keepalive 64;                 # إعادة استخدام الاتصالات مع الحاوية تحت الضغط
}

server {
    listen 80;
    server_name results.example.gov.sy;          # ← عدّل
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name results.example.gov.sy;          # ← عدّل

    # يضيفها certbot تلقائياً
    ssl_certificate     /etc/letsencrypt/live/results.example.gov.sy/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/results.example.gov.sy/privkey.pem;

    client_max_body_size 12M;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://competition_results;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 300s;
    }
}

# ملاحظة للضغط العالي: في /etc/nginx/nginx.conf اجعل
#   worker_processes auto;
#   events { worker_connections 4096; }
