# Nginx على السيرفر (المضيف) أمام Docker — يمرر الطلبات إلى حاوية nginx على 127.0.0.1:8060
# المسار: /etc/nginx/sites-available/competition-results
#   sudo ln -sf /etc/nginx/sites-available/competition-results /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

upstream competition_results {
    server 127.0.0.1:8060;
    keepalive 64;
}

server {
    # ---- الوضع الحالي: عبر IP والمنفذ 8052 (بدون SSL) ----
    listen 8052;
    # ---- عند ربط دومين: احذف السطر السابق وفعّل التالي ثم شغّل certbot ----
    # listen 443 ssl http2;
    # server_name results.example.gov.sy;
    # ssl_certificate     /etc/letsencrypt/live/results.example.gov.sy/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/results.example.gov.sy/privkey.pem;
    # add_header Strict-Transport-Security "max-age=31536000" always;

    server_tokens off;
    client_max_body_size 12M;

    # ---- (اختياري، موصى به) لوحة التحكم من الشبكة الداخلية فقط ----
    # حتى لو سُرقت كلمة مرور، لا يمكن الدخول من الإنترنت. عدّل النطاق حسب شبكتكم.
    # location ~ ^/(admin|api/admin)(/|$) {
    #     allow 192.168.0.0/16;
    #     allow 127.0.0.1;
    #     deny all;
    #     proxy_pass http://competition_results;
    #     include /etc/nginx/snippets/competition-results-proxy.conf;
    # }

    location / {
        proxy_pass http://competition_results;
        include /etc/nginx/snippets/competition-results-proxy.conf;
    }
}

# ---- /etc/nginx/snippets/competition-results-proxy.conf ----
